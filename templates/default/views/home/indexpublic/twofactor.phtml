<style>
    .twofactor-code-inputs {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .twofactor-code-inputs .twofactor-digit {
        width: 54px;
        height: 54px;
        padding: 0;
        font-size: 24px;
        font-weight: 600;
    }

    @media (max-width: 576px) {
        .twofactor-code-inputs {
            gap: 8px;
        }

        .twofactor-code-inputs .twofactor-digit {
            width: 44px;
            height: 44px;
            font-size: 20px;
        }
    }
</style>

<script>
    $(function () {
        const $digits = $('.twofactor-digit');
        const $hidden = $('#verification_code');

        function updateHiddenValue() {
            let code = '';

            $digits.each(function () {
                code += $(this).val();
            });

            $hidden.val(code);
        }

        function handlePaste(value) {
            const cleanValue = value.replace(/[^0-9]/g, '').slice(0, 6);

            if (!cleanValue.length) {
                return;
            }

            $digits.each(function (index) {
                $(this).val(cleanValue[index] || '');
            });

            updateHiddenValue();

            const nextIndex = Math.min(cleanValue.length, 6) - 1;
            $digits.eq(nextIndex).focus();
        }

        $digits.on('input', function () {
            const value = $(this).val().replace(/[^0-9]/g, '').slice(0, 1);
            $(this).val(value);

            updateHiddenValue();

            if (value !== '') {
                $(this).next('.twofactor-digit').focus();
            }
        });

        $digits.on('keydown', function (e) {
            const $current = $(this);

            if (e.key === 'Backspace' && $current.val() === '') {
                $current.prev('.twofactor-digit').focus();
            }

            if (e.key === 'ArrowLeft') {
                e.preventDefault();
                $current.prev('.twofactor-digit').focus();
            }

            if (e.key === 'ArrowRight') {
                e.preventDefault();
                $current.next('.twofactor-digit').focus();
            }
        });

        $digits.on('paste', function (e) {
            e.preventDefault();

            const pastedData = (e.originalEvent || e).clipboardData.getData('text');
            handlePaste(pastedData);
        });

        $digits.first().focus();
    });
</script>