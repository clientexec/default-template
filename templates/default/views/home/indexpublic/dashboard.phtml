<script>
    $(document).ready(function () {

        $('#packages-table').DataTable({
            serverSide: true,
            searching: false,
            ordering: false,
            ajax: 'index.php?fuse=clients&controller=products&action=getdashboardpackages',
            columns: [
                { data: 'name', render: (val, _, row) => `<span class="product-name"><a href="index.php?fuse=clients&controller=products&view=product&id=${row.id}">${val}</a></span>` },
                { data: 'nextDueDate', render: (val) => `<span class="due-date">${val}</span>` },
                { data: 'price', render: (val, _, row) => `<span class="total">${val}<br>${row.term}</span>` },
                { data: 'status', render: (val, _, row) => `<span class="status ${row.status_class}">${val.replace(/ /g, '&nbsp;')}</span>` },
                { data: 'actions', orderable: false, defaultContent: '' }
            ]
        });

        $('#domains-table').DataTable({
            serverSide: true,
            searching: false,
            ordering: false,
            ajax: 'index.php?fuse=clients&controller=products&action=getdashboarddomains',
            columns: [
                { data: 'name', render: (val, _, row) => `<span class="product-name"><a href="index.php?fuse=clients&controller=products&view=product&id=${row.id}">${val}</a></span>` },
                { data: 'nextDueDate', render: (val) => `<span class="due-date">${val}</span>` },
                { data: 'price', render: (val, _, row) => `<span class="total">${val}${row.term && row.term !== '----' ? '<br>' + row.term : ''}</span>` },
                { data: 'status', render: (val, _, row) => `<span class="status ${row.status_class}">${val.replace(/ /g, '&nbsp;')}</span>` }
            ]
        });

        $('#packages-table, #domains-table').on('init.dt', function () {
            $.fn.matchHeight._update();
        });

    });

    $(document).on('click', '.clickable-action', function(e) {
        e.preventDefault();
        var command = $(this).data('command');
        var packageId = $(this).data('package-id');

        clientexec.mask();
        $.ajax({
            url: 'index.php?fuse=clients&action=callpluginaction',
            success: function(xhr) {
                clientexec.parseResponse(xhr);
                clientexec.unMask();
            },
            data: {
                id: packageId,
                actioncmd: command
            }
        });
    });
</script>