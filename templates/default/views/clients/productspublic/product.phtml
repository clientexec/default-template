<script>

    var productId = <?php echo (int) $this->product_id; ?>;
    var fields_markup_array = <?php echo json_encode($this->package['customFieldsMarkup']); ?>;

    function escapeHtml(text) {
        return $('<div>').text(text).html();
    }

    function customFieldColumnClass(value) {
        if (value.length > 50) {
            return 'medium';
        }
        if (value.length > 25) {
            return 'small';
        }
        return 'xsmall';
    }

    function openCustomFieldEditor(fieldName, key, type, columnClass, prefillValue) {
        var field = fields_markup_array[key];  //for cFHelper

        $.confirm({
            columnClass: columnClass,
            containerFluid: true,
            title: '',
            content: '' +
                '<form id="customFieldForm" action="">' +
                '<div class="form-group">' +
                '<label>' + escapeHtml(fieldName) + '<br>' + clientexec.lang('Please enter a new value') + '</label>' +
                field +
                '</div>' +
                '</form>',
            buttons: {
                formSubmit: {
                    text: clientexec.lang('Save'),
                    btnClass: 'btn btn-primary',
                    action: function () {
                        var form = $('#customFieldForm').parsley();
                        if (form.isValid()) {
                            var value = this.$content.find('.form-control').val();

                            $.post('index.php?fuse=clients&controller=products&action=updatecustomfield', {
                                id: productId,
                                fieldName: fieldName,
                                value: value,
                                type: type
                            }, function( data ) {
                                var response = clientexec.parseResponse(data);
                                if (response.success === true) {
                                    location.reload();
                                }
                            });
                        } else {
                            $('#parsley-errors-list').remove();
                            $('#formValueInput').after('<ul id="parsley-errors-list" class="parsley-errors-list filled" style="display: block;"><li class="parsley-required" style="display: list-item;">' + clientexec.lang('This value seems to be invalid') + '</li></ul>');
                            return false;
                        }
                    }
                },
                cancel: {
                    text: clientexec.lang('Cancel'),
                    action: function () {
                    }
                },
            },
            onContentReady: function () {
                var jc = this;
                if (prefillValue !== null) {
                    // Set via .val() so the value never passes through an HTML string.
                    this.$content.find('.form-control').val(prefillValue);
                }
                this.$content.find('form').on('submit', function (e) {
                    // if the user submits the form by pressing enter in the field.
                    e.preventDefault();
                    jc.$$formSubmit.trigger('click');
                });
            }
        });
    }

    <?php if ($this->showAutomaticRenewal) { ?>
    $('#toogle-automatic-cc-charge').on('click', function() {
        $.post('index.php?fuse=clients&controller=products&action=toogleautomaticcccharge', {
                id: productId
            },
            function(data) {
                clientexec.parseResponse(data);
            });
    });
    <?php } ?>


    <?php if ($this->package['registrarLock'] != '' && $this->package['status']['statusRaw'] == 'Active') { ?>
    $('#toogle-registrar-lock').on('click', function() {
        var regLockValue = 0;
        if ($(this).is(':checked')) {
            regLockValue = 1;
        }
        $.post('index.php?fuse=clients&controller=products&action=updateregistrarlock', {
                value: regLockValue,
                id: productId
            },
            function(data) {
                clientexec.parseResponse(data);
            });
    });
    <?php } ?>

    $('#passwordChange').on('click', function(e) {
        e.preventDefault();

        $.confirm({
            title: clientexec.lang('Password Change'),
            content: '' +
                '<form action="">' +
                '<div class="form-group">' +
                '<label>' + clientexec.lang('Please enter a new password') + '</label>' +
                '<input type="password" class="password form-control" />' +
                '</div>' +
                '</form>',
            buttons: {
                formSubmit: {
                    text: clientexec.lang('Save'),
                    btnClass: 'btn btn-primary',
                    action: function () {
                        var password = this.$content.find('.password').val();
                        if( $.trim(password) !== "" ) {
                            $.post('index.php?fuse=clients&controller=products&action=updatehostingpassword', {
                                id: productId,
                                password: password
                            }, function( data ) {
                                clientexec.parseResponse(data);
                            });
                        }
                    }
                },
                cancel: {
                    text: clientexec.lang('Cancel'),
                    action: function () {
                    }
                },
            },
            onContentReady: function () {
                var jc = this;
                this.$content.find('form').on('submit', function (e) {
                    // if the user submits the form by pressing enter in the field.
                    e.preventDefault();
                    jc.$$formSubmit.trigger('click');
                });
            }
        });
    });

    $('.customFieldModal').on('click', function(e){
        e.preventDefault();
        var content = String($(this).attr('data-content'));

        $.dialog({
            title: $(this).attr('data-name'),
            content: content,
            columnClass: customFieldColumnClass(content),
            containerFluid: true,
        });
    });

    $('.customFieldChange').on('click', function(e){
        e.preventDefault();
        var $link = $(this);
        var value = String($link.attr('data-value'));

        openCustomFieldEditor(
            $link.attr('data-name'),
            $link.attr('data-key'),
            $link.attr('data-type'),
            customFieldColumnClass(value),
            null
        );
    });

    $('.customFieldPasswordView').on('click', function(e){
        e.preventDefault();
        var $link = $(this);
        var fieldName = $link.attr('data-name');

        $.post('index.php?fuse=clients&controller=products&action=getcustomfieldvalue', {
            id: productId,
            fieldName: fieldName
        }, function( data ) {
            var response = clientexec.parseResponse(data);
            if (response.success !== true) {
                return;
            }

            var value = String(response.value);
            if ($link.attr('data-changeable') === '1') {
                openCustomFieldEditor(fieldName, $link.attr('data-key'), $link.attr('data-type'), 'small', value);
                return;
            }

            $.dialog({
                title: escapeHtml(fieldName),
                content: escapeHtml(value),
                columnClass: customFieldColumnClass(value),
                containerFluid: true,
            });
        });
    });

</script>

<style>
    .jconfirm-content {
        overflow-wrap: break-word;
    }
</style>