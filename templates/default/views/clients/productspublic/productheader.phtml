        <?php if (count($this->pluginActions) > 0) { ?>
            <div class="actions-header">
                <h4 class="my-0 font-actions">
                    <?php echo $this->user->lang('Quick Actions'); ?>
                </h4>
            </div>
            <ul class="actions">
                <?php $additionalHTML = ''; ?>
                <?php foreach ($this->pluginActions as $action) { ?>
                    <?php if (isset($action['url'])) { ?>
                        <li>
                            <a href="<?php echo $action['url']; ?>">
                                <i class="<?php echo $action['fa']; ?> fa-fw" aria-hidden="true"></i><?php echo $action['name']; ?>
                            </a>
                        </li>
                    <?php } else if (isset($action['link']) && $action['form'] == '') { ?>
                        <li>
                            <a target="_blank" href="<?php echo $action['link']; ?>">
                                <i class="<?php echo $action['fa']; ?> fa-fw" aria-hidden="true"></i><?php echo $action['text']; ?>
                            </a>
                        </li>
                    <?php } else if (isset($action['form']) && $action['form'] != '') { ?>
                        <li>
                            <a href="#" onclick="<?php echo $action['onclick']; ?>">
                                <i class="<?php echo $action['fa']; ?> fa-fw" aria-hidden="true"></i><?php echo $action['text']; ?>
                            </a>
                        </li>
                        <?php $additionalHTML .= $action['form']; ?>
                    <?php } else { ?>
                        <li>
                            <a href="#" class="clickable-action" data-command="<?php echo htmlspecialchars($action['command'], ENT_QUOTES); ?>"<?php if (!empty($action['confirm'])) { ?> data-confirm="<?php echo htmlspecialchars($action['confirm'], ENT_QUOTES); ?>"<?php } ?>>
                                <i class="<?php echo $action['fa']; ?> fa-fw" aria-hidden="true"></i><?php echo $action['name']; ?>
                            </a>
                        </li>
                    <?php } ?>
                <?php } ?>
            </ul>
            <?php echo $additionalHTML; ?>
        <?php } ?>
    </div>
</div>

<script>
    var packageId = '<?php echo $this->productId; ?>';

    function runPluginAction(command) {
        clientexec.mask();
        $.ajax({
            url: 'index.php?fuse=clients&action=callpluginaction',
            type: 'POST',
            data: {
                id: packageId,
                actioncmd: command,
                sessionHash: '<?php echo CE_Lib::getSessionHash(); ?>'
            },
            success: function(xhr) {
                const response = clientexec.parseResponse(xhr);
                if (response.error) {
                    clientexec.unMask();
                    return;
                }
                setTimeout(function() {
                    location.reload();
                }, 1500);
            },
            error: function() {
                clientexec.unMask();
                $.showNotification({body: clientexec.lang('There was an error performing this action'), type: 'danger'});
            }
        });
    }

    $('.clickable-action').on('click', function(e) {
        e.preventDefault();
        const command = $(this).data('command');
        const confirmMessage = $(this).data('confirm');

        if (!confirmMessage) {
            runPluginAction(command);
            return;
        }

        $.confirm({
            title: clientexec.lang('Please Confirm'),
            content: clientexec.htmlspecialchars(confirmMessage),
            buttons: {
                confirm: {
                    text: clientexec.lang('Confirm'),
                    btnClass: 'btn-danger',
                    action: function() {
                        runPluginAction(command);
                    }
                },
                cancel: {
                    text: clientexec.lang('Cancel')
                }
            }
        });
    });
</script>