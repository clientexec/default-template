<script>
$(document).ready(function() {
    var table = $('.product-list-table').DataTable({
        language: {
            emptyTable: clientexec.lang('No packages to show'),
            zeroRecords: clientexec.lang('No matching packages found')
        },
        "columnDefs": [{
            "targets": 4,
            "orderable": false
        }]
    });

    $('.knowledge-search-submit').on('keyup click', function() {
        table.search($('.knowledge-search-input').val()).draw();
    });
    $('.knowledge-search-input').keyup(function() {
        table.search($(this).val()).draw();
    });
});

function runPluginAction(packageId, command) {
    clientexec.mask();
    $.ajax({
        url: 'index.php?fuse=clients&action=callpluginaction',
        type: 'POST',
        data: {
            id: packageId,
            actioncmd: command,
            sessionHash: '<?php echo CE_Lib::getSessionHash(); ?>'
        },
        success: function(xhr) {
            const response = clientexec.parseResponse(xhr);
            if (response.error) {
                clientexec.unMask();
                return;
            }
            setTimeout(function() {
                location.reload();
            }, 1500);
        },
        error: function() {
            clientexec.unMask();
            $.showNotification({body: clientexec.lang('There was an error performing this action'), type: 'danger'});
        }
    });
}

$(document).on('click', '.clickable-action', function(e) {
    e.preventDefault();
    const command = $(this).data('command');
    const packageId = $(this).data('package-id');
    const confirmMessage = $(this).data('confirm');

    if (!confirmMessage) {
        runPluginAction(packageId, command);
        return;
    }

    $.confirm({
        title: clientexec.lang('Please Confirm'),
        content: clientexec.htmlspecialchars(confirmMessage),
        buttons: {
            confirm: {
                text: clientexec.lang('Confirm'),
                btnClass: 'btn-danger',
                action: function() {
                    runPluginAction(packageId, command);
                }
            },
            cancel: {
                text: clientexec.lang('Cancel')
            }
        }
    });
});

</script>