<script>
    var twoFactorUrl = 'index.php?fuse=clients&controller=twofactor&view=twofactor';

    function showTwoFactorError(box, message) {
        box.text(message).removeClass('d-none');
    }

    // Enable
    $('#verify2faBtn').on('click', function () {
        var code = $.trim($('#twofactor-code').val());
        var passwordInput = $('#twofactor-password');
        var password = passwordInput.val();
        var errorBox = $('#twofactor-error');
        var btn = $(this);

        errorBox.addClass('d-none').text('');

        if (!/^\d{6}$/.test(code)) {
            showTwoFactorError(errorBox, clientexec.lang('Please enter a valid 6-digit code'));
            return;
        }

        if (password === '') {
            showTwoFactorError(errorBox, clientexec.lang('Please enter your current password'));
            passwordInput.focus();
            return;
        }

        btn.prop('disabled', true).text(clientexec.lang('Verifying...'));

        $.ajax({
            url: 'index.php?fuse=clients&controller=twofactor&action=verify',
            method: 'POST',
            dataType: 'json',
            data: {
                code: code,
                password: password
            },
            success: function (response) {
                if (response.success) {
                    location.href = response.to_signup ? 'order.php?step=3' : twoFactorUrl;
                    return;
                }

                showTwoFactorError(errorBox, response.message || clientexec.lang('Invalid code'));
                passwordInput.val('');
                btn.prop('disabled', false).text(clientexec.lang('Verify & Enable'));
            },
            error: function () {
                showTwoFactorError(errorBox, clientexec.lang('An error occurred. Please try again.'));
                btn.prop('disabled', false).text(clientexec.lang('Verify & Enable'));
            }
        });
    });

    $('#enable2FAModal').on('shown.bs.modal', function () {
        $('#twofactor-code').focus();
    });

    $('#twofactor-code, #twofactor-password').on('input', function () {
        $('#twofactor-error').addClass('d-none').text('');
    });

    $('#twofactor-code, #twofactor-password').on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $('#verify2faBtn').trigger('click');
        }
    });

    // Disable
    $('#confirmDisable2faBtn').on('click', function () {
        var passwordInput = $('#disable2fa-password');
        var password = passwordInput.val();
        var errorBox = $('#disable2fa-error');
        var btn = $(this);

        errorBox.addClass('d-none').text('');

        if (password === '') {
            showTwoFactorError(errorBox, clientexec.lang('Please enter your current password'));
            passwordInput.focus();
            return;
        }

        btn.prop('disabled', true).text(clientexec.lang('Disabling...'));

        $.ajax({
            url: 'index.php?fuse=clients&controller=twofactor&action=disable',
            method: 'POST',
            dataType: 'json',
            data: {
                password: password
            },
            success: function (response) {
                if (response.success) {
                    location.href = twoFactorUrl;
                    return;
                }

                showTwoFactorError(errorBox, response.message || clientexec.lang('Failed to disable two-factor authentication.'));
                passwordInput.val('').focus();
                btn.prop('disabled', false).text(clientexec.lang('Disable'));
            },
            error: function () {
                showTwoFactorError(errorBox, clientexec.lang('An error occurred. Please try again.'));
                btn.prop('disabled', false).text(clientexec.lang('Disable'));
            }
        });
    });

    $('#disable2FAModal').on('shown.bs.modal', function () {
        $('#disable2fa-password').focus();
    });

    $('#disable2fa-password').on('input', function () {
        $('#disable2fa-error').addClass('d-none').text('');
    });

    $('#disable2fa-password').on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $('#confirmDisable2faBtn').trigger('click');
        }
    });
</script>