    "admin-prod": "cross-env process.env.section=admin NODE_ENV=production node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
    "dev": "npm run client-dev && npm run admin-dev",
    "watch": "npm run client-watch & npm run admin-watch",
    "prod": "npm run client-prod && npm run admin-prod"
  },
